# GitHub Linguist Overrides
# https://github.com/github-linguist/linguist/blob/master/docs/overrides.md

# Ignore all web, styling, script, and config files from language stats
*.js linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false
*.json linguist-detectable=false
*.xml linguist-detectable=false
*.sh linguist-detectable=false
scripts/** linguist-detectable=false
android/app/src/main/res/** linguist-detectable=false
android/gradle/** linguist-detectable=false

# Prioritize Rust core
*.rs linguist-detectable=true
*.rs linguist-language=Rust
rust-core/** linguist-detectable=true
rust-core/** linguist-language=Rust

# Android Kotlin
*.kt linguist-detectable=true
*.kt linguist-language=Kotlin
