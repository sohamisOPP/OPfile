<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OPfile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="colorPrimary">@color/electric_violet</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/toolbar_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/toolbar_surface</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="bottomSheetDialogTheme">@style/Theme.OPfile.BottomSheet</item>
        <item name="alertDialogTheme">@style/Theme.OPfile.Dialog</item>
    </style>

    <style name="Theme.OPfile.BottomSheet" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.OPfile.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <style name="Widget.OPfile.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/glass_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.OPfile.Sheet</item>
    </style>

    <style name="ShapeAppearance.OPfile.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.OPfile.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="colorSurface">@color/glass_surface</item>
        <item name="colorPrimary">@color/electric_violet</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
